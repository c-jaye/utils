{
    "name": "@cjaye/utils",
    "version": "1.0.5",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "author": "Charles Jaye",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/c-jaye/utils.git"
    },
    "private": false,
    "type": "module",
    "scripts": {
        "clean": "pnpx del-cli@latest --force \"**/pnpm-lock.yaml\" \"**/test-results.xml\" \"**/*.log\" \"**/node_modules\" \"**/dist\" \"**/.husky/_\" \"**/verdaccio/storage\" \"**/verdaccio/htpasswd\" \"**/verdaccio/config.yaml\"",
        "bump": "sed -i -E 's/\"version\": *\"[^\"]*\"/\"version\": \"'\"${GITHUB_REF_NAME#v}\"'\"/' package.json && rm -rf package.json-E",
        "prepare:all": "pnpm run prepare:verdaccio && pnpm run prepare:husky",
        "prepare:verdaccio": "sudo apt-get update || true && sudo apt-get install -y expect || true && chmod +x verdaccio/init verdaccio/login",
        "prepare:husky": "husky || true && chmod +x .husky/pre-push",
        "lint": "tsc -b && pnpm run lint:check",
        "lint:check": "pnpm eslint .",
        "lint:fix": "pnpm eslint . --fix",
        "test": "pnpm run lint && pnpm run test:unit",
        "test:unit": "vitest --no-watch",
        "dev:verdaccio": "verdaccio --listen 30333",
        "build": "pnpm run test && pnpm run build:bundle",
        "build:bundle": "unbuild",
        "prepublishOnly": "pnpx del-cli --force \"**/dist\" && pnpm run build:bundle",
        "publish:verdaccio": "pnpm run dev:verdaccio & sleep 3 && verdaccio/init || true && verdaccio/login && pnpm publish --access public --tag latest --no-git-checks --registry http://localhost:30333",
        "publish:npm": "pnpm publish --access public --tag latest --no-git-checks --registry registry.npmjs.org"
    },
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": "^24.15.0"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@vitest/coverage-v8": "^4.1.8",
        "eslint": "^10.4.1",
        "eslint-plugin-import-x": "^4.16.2",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "tinyglobby": "^0.2.17",
        "typescript": ">=5",
        "typescript-eslint": "^8.60.1",
        "unbuild": "^3.6.1",
        "verdaccio": "^6.7.2",
        "vitest": "^4.1.8"
    }
}
